(defwidget workspaces []
  (box
    :class "workspace-container"
    :orientation "h"
    :space-evenly false
    :spacing 8
    (workspace_button
      :index  {workspaces_data[0].index}
      :in_use {workspaces_data[0].in_use}
      :active {workspaces_data[0].active}
    )
    (workspace_button
      :index  {workspaces_data[1].index}
      :in_use {workspaces_data[1].in_use}
      :active {workspaces_data[1].active}
    )
    (workspace_button
      :index  {workspaces_data[2].index}
      :in_use {workspaces_data[2].in_use}
      :active {workspaces_data[2].active}
    )
    (workspace_button
      :index  {workspaces_data[3].index}
      :in_use {workspaces_data[3].in_use}
      :active {workspaces_data[3].active}
    )
    (workspace_button
      :index  {workspaces_data[4].index}
      :in_use {workspaces_data[4].in_use}
      :active {workspaces_data[4].active}
    )
    (workspace_button
      :index  {workspaces_data[5].index}
      :in_use {workspaces_data[5].in_use}
      :active {workspaces_data[5].active}
    )
    (workspace_button
      :index  {workspaces_data[6].index}
      :in_use {workspaces_data[6].in_use}
      :active {workspaces_data[6].active}
    )
    (workspace_button
      :index  {workspaces_data[7].index}
      :in_use {workspaces_data[7].in_use}
      :active {workspaces_data[7].active}
    )
    (workspace_button
      :index  {workspaces_data[8].index}
      :in_use {workspaces_data[8].in_use}
      :active {workspaces_data[8].active}
    )
    (workspace_button
      :index  {workspaces_data[9].index}
      :in_use {workspaces_data[9].in_use}
      :active {workspaces_data[9].active}
    )
    ; (for workspace in {workspaces_data}
    ;   (workspace_button
    ;     :index {workspace.index}
    ;     :in_use {workspace.in_use}
    ;     :active {workspace.active}
    ;   )
    ; )
  )
)

(deflisten workspaces_data
  :initial "[{\"index\":1,\"in_use\":true,\"active\":true},{\"index\":2,\"in_use\":false,\"active\":false},{\"index\":3,\"in_use\":false,\"active\":false},{\"index\":4,\"in_use\":false,\"active\":false},{\"index\":5,\"in_use\":false,\"active\":false},{\"index\":6,\"in_use\":false,\"active\":false},{\"index\":7,\"in_use\":false,\"active\":false},{\"index\":8,\"in_use\":false,\"active\":false},{\"index\":9,\"in_use\":false,\"active\":false},{\"index\":10,\"in_use\":false,\"active\":false}]"
  "./widgets/scripts/workspace.sh"
)

(defwidget workspace_button [index in_use active]
  (button
    :class "workspace ${in_use ? 'in_use' : ''} ${active ? 'active' : ''}"
    :onclick "hyprctl dispatch workspace ${index}"
    :width 20
    :height 20
  )
)
