(include "./widgets/shutdown.yuck")
(include "./widgets/music.yuck")
(include "./widgets/workspaces.yuck")
(include "./widgets/wifi.yuck")
(include "./widgets/audio.yuck")
(include "./widgets/cpu.yuck")
(include "./widgets/ram.yuck")
(include "./widgets/battery.yuck")
(include "./widgets/temps.yuck")
(include "./widgets/time.yuck")

(defwindow bar
  :monitor 0
  :geometry (geometry
    :x "0%"
    :y "0%"
    :width "100%"
    :anchor "top center"
  )
  :stacking "fg"
  :exclusive true
  (bar)
)

(defwidget bar []
  (centerbox
    :class "main"
    :orientation "h"
    (lefthand)
    (center)
    (righthand)
  )
)

(defwidget lefthand []
  (box
    :class "left"
    :orientation "h"
    :space-evenly false
    :spacing 8
    (shutdown)
    (workspaces)
  )
)

(defwidget center []
  (box
    :class "center"
    :orientation "h"
    :space-evenly false
    :spacing 10
    ; (music)
    (systray)    
  )
)

(defwidget righthand []
  (box
    :class "right"
    :orientation "h"
    :space-evenly true
    :spacing 0
    ; (wifi)
    (audio)
    (cpu)
    (ram)
    (battery)
    (temps)
    (time)
  )
)
